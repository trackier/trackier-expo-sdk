{
  "name": "apptrove-expo-sdk-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npx react-native run-android",
    "ios": "npx react-native run-ios",
    "start": "node node_modules/metro/src/cli.js start --port 8081 --host 0.0.0.0",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --scheme AppTroveExpoSdkExample --mode Debug --extra-params \"-sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO\""
  },
  "dependencies": {
    "apptrove-expo-sdk": "*",
    "react": "18.3.1",
    "react-native": "0.75.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/cli-platform-android": "14.0.0",
    "@react-native-community/cli-platform-ios": "14.0.0",
    "@react-native/babel-preset": "0.75.2",
    "@react-native/metro-config": "0.75.2",
    "@react-native/typescript-config": "0.75.2",
    "react-native-builder-bob": "^0.30.0"
  },
  "engines": {
    "node": ">=18"
  },
  "react-native": {
    "project": {
      "android": {
        "packageName": "apptroveexposdk.example"
      }
    }
  }
}
